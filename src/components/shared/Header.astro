---
import { Image } from 'astro:assets';
const navItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Proyek', href: '/#proyek' },
  { label: 'Blog', href: '/blog' },
  { label: 'Vlog', href: '/vlog' },
];
---

<header id="main-header" class="sticky top-0 z-40 w-full bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-transform duration-300">
  <div class="max-w-5xl mx-auto px-4 md:px-8 h-16 flex items-center justify-between">
    
    <a href="/" class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      <Image 
              src= "/Logo.svg"
              alt="Logo Arrosyid Al Ayubi"
              class="inline w-6 h-6 mr-2 -mt-1" 
              width={150}
              height={150}
              aria-label="logo"
              loading="eager"
            />
    </a>

    <nav class="hidden md:flex gap-8 items-center">
      <ul class="flex gap-6 font-medium text-sm text-slate-600 dark:text-slate-300">
        {navItems.map(item => (
          <li><a href={item.href} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">{item.label}</a></li>
        ))}
      </ul>
      
      <button id="theme-toggle" type="button" class="p-2 text-slate-600 dark:text-slate-300 focus:outline-none">
        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
      </button>
    </nav>

    <div class="md:hidden flex items-center gap-4">
      <button id="mobile-theme-toggle" aria-label="Toggle Dark Mode" class="p-2 text-slate-600 dark:text-slate-300 focus:outline-none">
         <svg id="mobile-theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
         </svg>
         <svg id="mobile-theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
         </svg>
      </button>

      <button id="mobile-menu-toggle" aria-label="Toggle navigasi" class="p-2 text-slate-600 dark:text-slate-300 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </div>

  <!-- PERBAIKAN 1: Menambahkan transisi animasi mulus (opacity, pointer-events, translate) menggantikan class 'hidden' -->
  <div id="mobile-menu" class="opacity-0 pointer-events-none -translate-y-2 md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 px-4 py-4 absolute w-full shadow-lg transition-all duration-300 ease-in-out">
    <ul class="flex flex-col gap-4 font-medium text-slate-600 dark:text-slate-300">
      {navItems.map(item => (
        <li><a href={item.href} class="block py-2 hover:text-blue-600 dark:hover:text-blue-400">{item.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<script>
  let lastScrollY = window.scrollY;
  let activeScrollHandler: ((e: Event) => void) | null = null;
  // Tambahkan variabel ini di luar
  let clickOutsideHandler: ((e: Event) => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    
    // ==========================================
    // 1. LOGIKA MOBILE MENU
    // ==========================================
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    
    if (btn && menu) {
      btn.onclick = () => {
        menu.classList.toggle('opacity-0');
        menu.classList.toggle('pointer-events-none');
        menu.classList.toggle('-translate-y-2');
      };
    }

    // --- TAMBAHAN: Logika Klik di Luar Menu ---
    // Bersihkan listener lama (jika ada)
    if (clickOutsideHandler) {
      document.removeEventListener('click', clickOutsideHandler);
    }
    
    clickOutsideHandler = (event: Event) => {
      const target = event.target as Node;
      
      // Jika menu sedang terbuka (tidak ada opacity-0)
      if (menu && btn && !menu.classList.contains('opacity-0')) {
        // Jika klik BUKAN pada menu dan BUKAN pada tombol
        if (!menu.contains(target) && !btn.contains(target)) {
          menu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
        }
      }
    };

    // Pasang pendeteksi klik ke seluruh halaman
    document.addEventListener('click', clickOutsideHandler);
    // ==========================================
    // 2. LOGIKA DARK MODE
    // ==========================================
    const desktopDarkIcon = document.getElementById('theme-toggle-dark-icon');
    const desktopLightIcon = document.getElementById('theme-toggle-light-icon');
    const mobileDarkIcon = document.getElementById('mobile-theme-toggle-dark-icon');
    const mobileLightIcon = document.getElementById('mobile-theme-toggle-light-icon');

    // PERBAIKAN 3: Mendeklarasikan tipe 'boolean' pada parameter isDark
    const updateIcons = (isDark: boolean) => {
      if (isDark) {
        desktopDarkIcon?.classList.add('hidden');
        desktopLightIcon?.classList.remove('hidden');
        mobileDarkIcon?.classList.add('hidden');
        mobileLightIcon?.classList.remove('hidden');
      } else {
        desktopDarkIcon?.classList.remove('hidden');
        desktopLightIcon?.classList.add('hidden');
        mobileDarkIcon?.classList.remove('hidden');
        mobileLightIcon?.classList.add('hidden');
      }
    };

    const isDarkMode = localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
    updateIcons(isDarkMode);

    const toggleTheme = () => {
      const willBeDark = !document.documentElement.classList.contains('dark');
      
      if (willBeDark) {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
      } else {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
      }
      
      updateIcons(willBeDark);
    };

    const btnDesktop = document.getElementById('theme-toggle');
    const btnMobile = document.getElementById('mobile-theme-toggle');
    if (btnDesktop) btnDesktop.onclick = toggleTheme;
    if (btnMobile) btnMobile.onclick = toggleTheme;

    // ==========================================
    // 3. LOGIKA SMART HEADER (Hide on Scroll)
    // ==========================================
    const header = document.getElementById('main-header');
    
    const handleScroll = () => {
      if (!header) return;
      const currentScrollY = window.scrollY;
      
      if (currentScrollY > lastScrollY && currentScrollY > 50) {
        header.classList.add('-translate-y-full');
      } else {
        header.classList.remove('-translate-y-full');
      }
      
      lastScrollY = currentScrollY;
    };

    // Bersihkan event listener sebelumnya agar tidak bertumpuk saat pindah halaman
    if (activeScrollHandler) {
      window.removeEventListener('scroll', activeScrollHandler);
    }
    
    activeScrollHandler = handleScroll;
    window.addEventListener('scroll', activeScrollHandler, { passive: true });

  });
</script>